{
    "name": "gerenuk/filament-table-views",
    "description": "Saved table views and column-based advanced filters for Filament.",
    "keywords": [
        "gerenuk",
        "laravel",
        "filament",
        "tables",
        "saved-views",
        "filament-table-views"
    ],
    "homepage": "https://github.com/Gerenuk-LTD/filament-table-views",
    "support": {
        "issues": "https://github.com/Gerenuk-LTD/filament-table-views/issues",
        "source": "https://github.com/Gerenuk-LTD/filament-table-views"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Kieran Proctor",
            "email": "kieran.lee.proctor@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.11.0",
        "illuminate/contracts": "^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Gerenuk\\FilamentTableViews\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gerenuk\\FilamentTableViews\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gerenuk\\FilamentTableViews\\FilamentTableViewsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
